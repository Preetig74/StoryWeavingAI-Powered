# Example environment variables for AI-Powered Story Weaver
# Copy this file to .env and fill in your actual API keys

# Choose your LLM provider: openai, groq, or openrouter
#LLM_PROVIDER=groq

# OpenAI Configuration
# OPENAI_API_KEY=your_openai_api_key_here
# MODEL_NAME=gpt-4o-mini

# Groq Configuration (uncomment and fill if using Groq)
 LLM_PROVIDER=groq
 GROQ_API_KEY=your_groq_api_key_here
 MODEL_NAME=llama-3.3-70b-versatile

# OpenRouter Configuration (uncomment and fill if using OpenRouter)
# LLM_PROVIDER=openrouter
# OPENROUTER_API_KEY=your_openrouter_api_key_here
# MODEL_NAME=openai/gpt-4o-mini